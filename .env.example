# ─── Database Configuration ───────────────────────────────────────────
# Option A: Standard host/port parameters
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=petrolbunk
DB_USER=root
DB_PASSWORD=your_database_password
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_MIN=0

# Option B: Cloud single-connection string (e.g. Railway, Render, Heroku, PlanetScale, AWS)
# If DATABASE_URL is set, it takes precedence over DB_HOST/DB_NAME above
# DATABASE_URL=mysql://user:password@host:3306/dbname

# ─── Security & Authentication ───────────────────────────────────────
# IMPORTANT: In production, generate a strong random 64-character secret
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_DAYS=7

# Cookie SameSite policy:
# • Use 'lax' if frontend and backend share the same domain or are behind Nginx proxy
# • Use 'none' if frontend (e.g. Vercel) and backend (e.g. Render/Railway) are on different domains
# Default: 'lax' in development, 'none' in production
COOKIE_SAME_SITE=lax

# ─── Server Configuration ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS Configuration ───────────────────────────────────────────────
# Comma-separated allowed frontend origins (NO trailing slashes)
# E.g.: FRONTEND_URL=http://localhost:5173,https://mybunk.vercel.app,https://admin.petrolbunk.com
FRONTEND_URL=http://localhost:5173

# ─── Fuel Rates & Auto-fetch Configuration ────────────────────────────
# Official Indian district/city for daily fuel price sync (e.g. chittoor, madanapalle, hyderabad, bangalore)
FUEL_CITY=madanapalle
AUTO_FETCH_RATES=true
DEFAULT_MS_PRICE=104.50
DEFAULT_HSD_PRICE=91.20
DEFAULT_MS_COMMISSION=3.50
DEFAULT_HSD_COMMISSION=3.00

# ─── Optional Email Alerts ────────────────────────────────────────────
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
ADMIN_EMAIL=admin@example.com
